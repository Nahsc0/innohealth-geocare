# Copy to .env before docker compose. Use unique secrets for each environment.
POSTGRES_PASSWORD=
DATA_KEY=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Root frontend origin(s), without trailing slash
FRONTEND_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional OSM-derived provider raster template. Required for hosted maps.
NEXT_PUBLIC_TILE_URL=
# Use an approved OSRM deployment with Nigerian driving data.
OSRM_BASE_URL=
# Omit the key and select disabled or mock. A test key uses NIPOST's own sandbox.
POSTCODE_MODE=mock
NIPOST_API_KEY=
# Optional private Google Sheets facility directory for Administration → Refresh from Google Sheets.
GOOGLE_SHEETS_SPREADSHEET_ID=
# Use Application Default Credentials or mount a service-account key via your host's secret storage.
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/private/credentials.json
# Hosted self-service accounts use a signed Apps Script registry. Set both as backend secrets.
APPS_SCRIPT_REGISTRY_URL=
APPS_SCRIPT_REGISTRY_SECRET=
# Local browser tests only. Use an ignored path for the simulated email inbox.
# GEOCARE_DEV_MAILBOX=/path/to/ignored/geocare-test-mail.jsonl
# Set on the backend hosting platform. Compose builds this internally for local use.
# DATABASE_URL=postgresql+psycopg://runtime_user:encoded_password@db-host/geocare?sslmode=verify-full
# Set only when your host strips spoofed forwarding headers and the proxy addresses are known.
# FORWARDED_ALLOW_IPS=127.0.0.1
