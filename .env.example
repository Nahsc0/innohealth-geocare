# Copy to .env before docker compose. Use unique secrets for each environment.
POSTGRES_PASSWORD=
DATA_KEY=
BOOTSTRAP_EMAIL=
BOOTSTRAP_PASSWORD=
# Root frontend origin(s), without trailing slash
FRONTEND_ORIGINS=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
# Optional OSM-derived provider raster template. Required for hosted maps.
NEXT_PUBLIC_TILE_URL=
# Use an approved OSRM deployment with Nigerian driving data.
OSRM_BASE_URL=
# Omit the key and select disabled or mock. A test key uses NIPOST's own sandbox.
POSTCODE_MODE=mock
NIPOST_API_KEY=
# Set on the backend hosting platform. Compose builds this internally for local use.
# DATABASE_URL=postgresql+psycopg://runtime_user:encoded_password@db-host/geocare?sslmode=verify-full
# Set only when your host strips spoofed forwarding headers and the proxy addresses are known.
# FORWARDED_ALLOW_IPS=127.0.0.1
